#!/usr/bin/env bash
# Canonical developer entry point for common Arcogine workflows. Thin
# orchestrator over the project's own tools — it does not replace them.
#
# For anything more specific than the commands below, use the subsystem's
# native tool directly:
#   cd product && ./gradlew <task>       # Java: coverage, Checkstyle, jmh, audit
#   trivy / gitleaks                     # security scans
# See docs/development/testing.md for the full native-command reference.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || echo "$SCRIPT_DIR")"
cd "$REPO_ROOT"

PRODUCT_DIR="$REPO_ROOT/product"

gradle() {
  (cd "$PRODUCT_DIR" && ./gradlew --no-daemon "$@")
}

require_commands() {
  local workflow="$1"
  shift
  local missing=()
  local command

  for command in "$@"; do
    if ! command -v "$command" >/dev/null 2>&1; then
      missing+=("$command")
    fi
  done

  if (( ${#missing[@]} > 0 )); then
    printf 'FATAL: %s requires the following unavailable tool(s): %s\n' \
      "$workflow" "${missing[*]}" >&2
    echo "Run a narrower source check instead, or provision only the listed capability." >&2
    exit 1
  fi
}

usage() {
  cat <<'EOF'
Usage: ./arcogine <command> [args]

Commands:
  setup             Optional Java dependency bootstrap (safe to re-run)
  test              Run Java unit tests
  check             Java compile, style, tests, and coverage gates
  check --full      Everything in check, plus dependency audit and secret scan
  snapshot          Generate the canonical whole-repository AI retrieval snapshot

For anything more specific, use the subsystem's native tool directly:
  cd product && ./gradlew <task>                 # Java: coverage, Checkstyle, jmh, audit
  trivy / gitleaks                               # security scans
See docs/development/testing.md for the full native-command reference.
EOF
}

cmd_snapshot() {
  require_commands "./arcogine snapshot" node npx
  node "$REPO_ROOT/infra/dev/repo-snapshot.mjs"
}

cmd_setup() {
  echo "==> Resolving Java toolchain and dependencies..."
  gradle help
}

cmd_test() {
  echo "==> Running Java tests..."
  gradle test
}

cmd_check() {
  if [[ "${1:-}" == "--full" ]]; then
    require_commands "./arcogine check --full security certification" trivy gitleaks
  fi

  echo "==> Java: compile, Checkstyle, tests, coverage gates..."
  gradle compileJava compileTestJava checkstyleMain checkstyleTest \
    test jacocoTestReport jacocoTestCoverageVerification

  if [[ "${1:-}" == "--full" ]]; then
    echo "==> Security: dependency audit, secret scan..."
    gradle cyclonedxBom
    trivy sbom --severity CRITICAL,HIGH --ignore-unfixed --exit-code 1 \
      "$PRODUCT_DIR/build/reports/cyclonedx/bom.json"
    gitleaks detect --source . --config .github/security/gitleaks.toml --verbose
  fi
}

cmd="${1:-}"
case "$cmd" in
  setup|test)
    if [[ $# -ne 1 ]]; then
      echo "Usage: ./arcogine $cmd" >&2
      exit 1
    fi
    cmd_"$cmd"
    ;;
  check)
    if [[ $# -gt 2 || ( $# -eq 2 && "$2" != "--full" ) ]]; then
      echo "Usage: ./arcogine check [--full]" >&2
      exit 1
    fi
    shift
    cmd_check "${1:-}"
    ;;
  snapshot)
    if [[ $# -ne 1 ]]; then
      echo "Usage: ./arcogine snapshot" >&2
      exit 1
    fi
    cmd_snapshot
    ;;
  "")
    usage
    ;;
  -h|--help)
    if [[ $# -ne 1 ]]; then
      echo "Usage: ./arcogine $cmd" >&2
      exit 1
    fi
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
