#!/usr/bin/env bash
# Canonical developer entry point for common Arcogine workflows. Thin
# orchestrator over the project's own tools — it does not replace them.
#
# For anything more specific than the commands below, use the subsystem's
# native tool directly:
#   cd product && ./gradlew <task>       # Java: coverage, Checkstyle, bootJar, jmh, audit
#   cd product/interfaces/web && npm ... / npx ...   # frontend: lint, typecheck, build, Playwright
#   docker compose ...                   # containers
#   trivy / gitleaks                     # security scans
# See docs/development/testing.md for the full native-command reference.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || echo "$SCRIPT_DIR")"
cd "$REPO_ROOT"

PRODUCT_DIR="$REPO_ROOT/product"
WEB_DIR="$REPO_ROOT/product/interfaces/web"
DIST_DIR="$REPO_ROOT/dist"
DOCKER_DIR="$REPO_ROOT/infra/docker"

API_IMAGE="arcogine-api:ci"
WEB_IMAGE="arcogine-ui:ci"

gradle() {
  (cd "$PRODUCT_DIR" && ./gradlew --no-daemon "$@")
}

npm_web() {
  (cd "$WEB_DIR" && npm "$@")
}

npx_web() {
  (cd "$WEB_DIR" && npx "$@")
}

compose() {
  docker compose \
    --project-directory "$REPO_ROOT" \
    --env-file "$REPO_ROOT/.env" \
    -f "$DOCKER_DIR/compose.yaml" \
    "$@"
}

require_commands() {
  local workflow="$1"
  shift
  local missing=()
  local command

  for command in "$@"; do
    if ! command -v "$command" >/dev/null 2>&1; then
      missing+=("$command")
    fi
  done

  if (( ${#missing[@]} > 0 )); then
    printf 'FATAL: %s requires the following unavailable tool(s): %s\n' \
      "$workflow" "${missing[*]}" >&2
    echo "Run a narrower source check instead, or provision only the listed capability." >&2
    exit 1
  fi
}

# Actual host port Compose bound for a running service, per Compose itself
# (not a reimplementation of its .env/env-var precedence). Only meaningful
# after `compose up`. container_port is the port as declared in compose.yaml.
bound_port() {
  local service="$1" container_port="$2"
  compose port "$service" "$container_port" | sed -E 's/^.*://'
}

usage() {
  cat <<'EOF'
Usage: ./arcogine <command> [args]

Commands:
  setup             Optional full-development dependency bootstrap (safe to re-run)
  test              Run Java + frontend unit test suites
  check             Fast quality gates: compile, lint, typecheck, tests, coverage, build
  check --full      Everything in check, plus Playwright E2E, canonical dist/
                     build, Docker image build + smoke test, and security scans
  build             Produce the canonical dist/ (dist/api/arcogine.jar, dist/web/)
  image             Package existing dist/ into runtime Docker images
  up                Build, package, and start the full local container stack
  down              Stop the local container stack
  run api           Start the Spring Boot API in development mode (Gradle)
  run web           Start the Vite dev server on :5173
  run ui            Alias for 'run web'
  run scenario PATH Run a headless scenario through the native Java CLI

For anything more specific, use the subsystem's native tool directly:
  cd product && ./gradlew <task>                 # Java: coverage, Checkstyle, bootJar, jmh, audit
  cd product/interfaces/web && npm ... / npx ...  # frontend: lint, typecheck, build, Playwright
  docker compose ...                             # containers
  trivy / gitleaks                               # security scans
See docs/development/testing.md for the full native-command reference.
EOF
}

cmd_setup() {
  echo "==> Optional full-development bootstrap (frontend, browser, and Java dependencies)..."
  echo "==> Installing frontend dependencies..."
  npm_web ci
  echo "==> Installing Playwright Chromium browser for E2E tests..."
  npx_web playwright install chromium
  echo "==> Resolving Java toolchain and dependencies..."
  gradle help
}

cmd_test() {
  echo "==> Running Java tests..."
  gradle test
  echo "==> Running frontend tests..."
  npm_web test
}

cmd_check() {
  if [[ "${1:-}" == "--full" ]]; then
    require_commands "./arcogine check --full container/security certification" \
      docker trivy gitleaks curl
    if ! docker compose version >/dev/null 2>&1; then
      echo "FATAL: ./arcogine check --full requires Docker Compose." >&2
      echo "Run './arcogine check' for portable source validation instead." >&2
      exit 1
    fi
  fi

  echo "==> Java: compile, Checkstyle, tests, coverage gates..."
  gradle compileJava compileTestJava checkstyleMain checkstyleTest \
    test jacocoTestReport jacocoTestCoverageVerification

  echo "==> Frontend: lint, typecheck, tests + coverage, build..."
  npm_web run lint
  npx_web tsc --noEmit
  npm_web run test:coverage
  npm_web run build

  if [[ "${1:-}" == "--full" ]]; then
    echo "==> Building API JAR for Playwright's webServer..."
    gradle :cli:bootJar

    echo "==> Playwright E2E..."
    npx_web playwright test

    echo "==> Building canonical dist/..."
    cmd_build

    echo "==> Building runtime images from dist/..."
    cmd_image

    echo "==> Docker smoke test..."
    cp -n .env.example .env 2>/dev/null || true
    compose up -d --wait --wait-timeout 120
    trap 'compose down' EXIT
    curl -sf "http://localhost:$(bound_port api 3000)/api/health" > /dev/null
    curl -sf "http://localhost:$(bound_port ui 5173)/health" > /dev/null
    compose down
    trap - EXIT

    echo "==> Security: dependency audit, image scans, secret scan..."
    gradle cyclonedxBom
    trivy sbom --severity CRITICAL,HIGH --ignore-unfixed --exit-code 1 \
      "$PRODUCT_DIR/build/reports/cyclonedx/bom.json"
    npm_web audit --audit-level=high
    trivy image --severity CRITICAL,HIGH --ignore-unfixed --exit-code 1 "$API_IMAGE"
    trivy image --severity CRITICAL,HIGH --ignore-unfixed --exit-code 1 "$WEB_IMAGE"
    gitleaks detect --source . --config .gitleaks.toml --verbose
  fi
}

cmd_build() {
  echo "==> Refreshing dist/..."
  rm -rf "$DIST_DIR"
  mkdir -p "$DIST_DIR/api" "$DIST_DIR/web"

  echo "==> Building executable Java artifact (dist/api/arcogine.jar)..."
  gradle :cli:stageDist

  echo "==> Building production frontend (dist/web/)..."
  ARCOGINE_DIST_WEB="../../../dist/web" npm_web run build

  if [[ ! -f "$DIST_DIR/api/arcogine.jar" ]]; then
    echo "FATAL: build did not produce $DIST_DIR/api/arcogine.jar" >&2
    exit 1
  fi
  if [[ ! -f "$DIST_DIR/web/index.html" ]]; then
    echo "FATAL: build did not produce $DIST_DIR/web/index.html" >&2
    exit 1
  fi
  echo "==> dist/ ready: dist/api/arcogine.jar, dist/web/"
}

cmd_image() {
  require_commands "./arcogine image" docker
  if [[ ! -f "$DIST_DIR/api/arcogine.jar" ]]; then
    echo "FATAL: $DIST_DIR/api/arcogine.jar not found. Run './arcogine build' first." >&2
    exit 1
  fi
  if [[ ! -f "$DIST_DIR/web/index.html" ]]; then
    echo "FATAL: $DIST_DIR/web/index.html not found. Run './arcogine build' first." >&2
    exit 1
  fi

  echo "==> Building API image ($API_IMAGE) from dist/api/..."
  docker build -f "$DOCKER_DIR/api.Dockerfile" -t "$API_IMAGE" "$DIST_DIR/api"

  echo "==> Building web image ($WEB_IMAGE) from dist/web/..."
  docker build -f "$DOCKER_DIR/web.Dockerfile" -t "$WEB_IMAGE" "$DIST_DIR/web"
}

cmd_up() {
  require_commands "./arcogine up" docker
  if ! docker compose version >/dev/null 2>&1; then
    echo "FATAL: ./arcogine up requires Docker Compose." >&2
    exit 1
  fi
  if [[ "${1:-}" != "--no-rebuild" ]]; then
    cmd_build
    cmd_image
  fi
  cp -n .env.example .env 2>/dev/null || true
  compose up -d --wait --wait-timeout 120
  echo "==> Stack up. API: http://localhost:$(bound_port api 3000)  Web: http://localhost:$(bound_port ui 5173)"
}

cmd_down() {
  require_commands "./arcogine down" docker
  if ! docker compose version >/dev/null 2>&1; then
    echo "FATAL: ./arcogine down requires Docker Compose." >&2
    exit 1
  fi
  cp -n .env.example .env 2>/dev/null || true
  compose down
}

cmd_run() {
  case "$1" in
    api) gradle :cli:bootRun --args=serve ;;
    web|ui) npm_web run dev ;;
    scenario)
      local scenario_path="$2"
      if [[ "$scenario_path" != /* ]]; then
        scenario_path="$REPO_ROOT/$scenario_path"
      fi
      gradle :cli:bootRun --args="run $scenario_path"
      ;;
  esac
}

cmd="${1:-}"
case "$cmd" in
  setup|test)
    if [[ $# -ne 1 ]]; then
      echo "Usage: ./arcogine $cmd" >&2
      exit 1
    fi
    cmd_"$cmd"
    ;;
  check)
    if [[ $# -gt 2 || ( $# -eq 2 && "$2" != "--full" ) ]]; then
      echo "Usage: ./arcogine check [--full]" >&2
      exit 1
    fi
    shift
    cmd_check "${1:-}"
    ;;
  build)
    if [[ $# -ne 1 ]]; then
      echo "Usage: ./arcogine build" >&2
      exit 1
    fi
    cmd_build
    ;;
  image)
    if [[ $# -ne 1 ]]; then
      echo "Usage: ./arcogine image" >&2
      exit 1
    fi
    cmd_image
    ;;
  up)
    if [[ $# -gt 2 || ( $# -eq 2 && "$2" != "--no-rebuild" ) ]]; then
      echo "Usage: ./arcogine up [--no-rebuild]" >&2
      exit 1
    fi
    shift
    cmd_up "${1:-}"
    ;;
  down)
    if [[ $# -ne 1 ]]; then
      echo "Usage: ./arcogine down" >&2
      exit 1
    fi
    cmd_down
    ;;
  run)
    if [[ $# -eq 2 && ( "$2" == "api" || "$2" == "web" || "$2" == "ui" ) ]]; then
      shift
      cmd_run "$1"
    elif [[ $# -eq 3 && "$2" == "scenario" ]]; then
      shift
      cmd_run "$1" "$2"
    else
      echo "Usage: ./arcogine run {api|web|scenario <path>}" >&2
      exit 1
    fi
    ;;
  clean)
    echo "==> Removing dist/ ..."
    rm -rf "$DIST_DIR"
    ;;
  ""|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
