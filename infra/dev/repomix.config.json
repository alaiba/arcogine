{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "style": "xml",
    "filePathStyle": "target-relative",
    "compress": false,
    "removeComments": false,
    "showLineNumbers": false,
    "fileSummary": false,
    "directoryStructure": true,
    "files": true,
    "git": {
      "sortByChanges": false,
      "includeDiffs": false,
      "includeLogs": false
    }
  },
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": false,
    "useDefaultPatterns": false,
    "customPatterns": [
      ".git/**",
      "**/*.pem",
      "**/*.key",
      "**/.env",
      "**/.env.local",
      "**/.env.*.local"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
